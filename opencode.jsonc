{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "backlog *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "date *": "allow",
      "deno fmt *": "allow",
      "deno lint *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "git add *": "allow",
      "git checkout *": "ask",
      "git commit *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git push *": "allow",
      "git push --force*": "ask",
      "git rev-parse *": "allow",
      "git reset --hard*": "ask",
      "git show *": "allow",
      "git status *": "allow",
      "git switch *": "ask",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mise *": "allow",
      "mv *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "prek *": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "tail *": "allow",
      "task *": "allow",
      "touch *": "allow",
      "tree *": "allow",
      "wc *": "allow",
      "yq *": "allow"
    }
  }
}
