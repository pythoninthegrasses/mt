# ==============================================================================
# Docker cross-build for aarch64-unknown-linux-gnu (Raspberry Pi CM5)
#
# Runs natively on Apple Silicon — no QEMU overhead.
# Base image matches target OS (Debian 13 trixie).
#
# Usage:
#   task build:linux-arm64
#   # or manually:
#   docker build --platform linux/arm64 \
#     -f docker/Dockerfile.linux-arm64 \
#     --target artifacts --output type=local,dest=dist/linux-arm64 .
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build environment
# ------------------------------------------------------------------------------
FROM debian:trixie-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

# -- System packages: build tools --
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    cmake \
    mold \
    curl \
    wget \
    file \
    ca-certificates \
    git \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# -- System packages: Tauri + audio dev libraries --
ARG WEBKIT_VERSION=4.1
ARG SOUP_VERSION=3.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libjavascriptcoregtk-${WEBKIT_VERSION}-dev \
    libwebkit2gtk-${WEBKIT_VERSION}-dev \
    libsoup-${SOUP_VERSION}-dev \
    libgtk-3-dev \
    libasound2-dev \
    libdbus-1-dev \
    libayatana-appindicator3-dev \
    zlib1g-dev \
    libutfcpp-dev \
    libssl-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

# -- Rust (nightly) --
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain nightly --profile minimal \
    && rustup target add aarch64-unknown-linux-gnu

# -- Zig --
ARG ZIG_VERSION=0.14.0
RUN curl -sSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-aarch64-${ZIG_VERSION}.tar.xz" \
    | tar -xJ -C /opt \
    && ln -s /opt/zig-linux-aarch64-${ZIG_VERSION}/zig /usr/local/bin/zig

# -- Node.js --
ARG NODE_MAJOR=24
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# -- Deno --
RUN curl -fsSL -L https://github.com/denoland/deno/releases/latest/download/deno-aarch64-unknown-linux-gnu.zip \
    -o /tmp/deno.zip \
    && unzip -o /tmp/deno.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/deno \
    && rm /tmp/deno.zip

# -- Build environment --
ENV RUSTUP_TOOLCHAIN=nightly \
    RUSTFLAGS="-Zthreads=16"

WORKDIR /build

# -- Layer: dependency files (cached unless deps change) --
COPY Cargo.toml Cargo.lock ./
COPY crates/mt-core/Cargo.toml crates/mt-core/
COPY crates/mt-core/build.rs crates/mt-core/
COPY crates/mt-tauri/Cargo.toml crates/mt-tauri/
COPY crates/mt-tauri/.cargo crates/mt-tauri/.cargo/

# Stub source files for cargo fetch
RUN mkdir -p crates/mt-core/src && echo "pub fn stub() {}" > crates/mt-core/src/lib.rs \
    && mkdir -p crates/mt-tauri/src && echo "fn main() {}" > crates/mt-tauri/src/main.rs \
    && echo "" > crates/mt-tauri/src/lib.rs

RUN cargo fetch --target aarch64-unknown-linux-gnu

# Frontend deps
COPY deno.jsonc deno.lock ./
COPY app/frontend/package.json app/frontend/package-lock.json app/frontend/

RUN deno install --node-modules-dir=auto

# -- Layer: full source --
RUN rm -rf crates/mt-core/src crates/mt-tauri/src

COPY crates/ crates/
COPY app/ app/
COPY zig-core/ zig-core/
COPY scripts/ scripts/
COPY static/ static/

# -- Build TagLib for Linux (force — ignore any host-platform .a files) --
RUN bash scripts/build-taglib.sh --force

# -- Build frontend --
RUN cd app/frontend && npm run build

# -- Build Tauri app --
RUN deno run -A npm:@tauri-apps/cli build \
    --target aarch64-unknown-linux-gnu \
    --bundles deb

# ------------------------------------------------------------------------------
# Stage 2: Artifact extraction
# ------------------------------------------------------------------------------
FROM scratch AS artifacts

COPY --from=builder /build/target/aarch64-unknown-linux-gnu/release/bundle/deb/*.deb /
COPY --from=builder /build/target/aarch64-unknown-linux-gnu/release/mt-tauri /mt-tauri
