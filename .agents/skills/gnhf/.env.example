# Copy to .env (same directory) to override gnhf.py's defaults.
# CLI flags override these; these override the hardcoded defaults.

# --- smoke-test mode ---
GNHF_PROVIDER=
GNHF_MODEL=
GNHF_TIMEOUT=300
GNHF_MAX_RETRIES=2

# --- launch mode ---
GNHF_TTL=10800
GNHF_PROBE=25
GNHF_BASE_BACKOFF=75
GNHF_MAX_BACKOFF=900
GNHF_MAX_429=6
GNHF_TOTAL_BACKOFF_CAP=2700
